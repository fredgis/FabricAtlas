@startuml
top to bottom direction
hide circle
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam shadowing false
skinparam linetype ortho
skinparam entityBackgroundColor #FFFFFF
skinparam entityBorderColor #0078D4
skinparam entityFontColor #0078D4
skinparam packageBackgroundColor #FAFAFA
skinparam packageBorderColor #D1D1D1

title Fabric Atlas 2.0 | Physical data model (Fabric SQL)

package "Snapshot catalog" {
  entity Workspaces
  entity FabricItems
  entity LineageEdges
  entity Principals
  entity AccessGrants
  entity JobRuns
  entity ConfigEntries
}

package "Sync control" {
  entity SyncRuns
  entity SyncJobs
  entity SyncTasks
  entity SyncCommands
  entity SyncRootRuns
  entity SyncPayloadManifests
  entity SyncPayloadChunks
}

package "Shared control" {
  entity Comments
  entity GovernancePolicies
  entity GovernanceExceptions
  entity WorkspaceScopes
  entity SynchronizerAuthorities
}

package "Personal state" {
  entity SavedViews
  entity AccessReviews
  entity AccessReviewEvents
  entity FindingAcks
}

package "Evidence stores" {
  entity ItemRelationsEvidenceSnapshots
  entity AccessPolicyEvidences
  entity OperationalIncidents
}

Workspaces ..> FabricItems : workspace + snapshot
Workspaces ..> LineageEdges : workspace + snapshot
Workspaces ..> Principals : workspace + snapshot
Workspaces ..> AccessGrants : workspace + snapshot
Workspaces ..> JobRuns : workspace + snapshot
Workspaces ..> ConfigEntries : workspace + snapshot
Workspaces ..> SyncRuns : workspace
Workspaces ..> Comments : workspace
Workspaces ..> GovernancePolicies : workspace
Workspaces ..> GovernanceExceptions : workspace
Workspaces ..> SavedViews : workspace + user
Workspaces ..> AccessReviews : workspace + user
Workspaces ..> AccessReviewEvents : workspace + user
Workspaces ..> FindingAcks : workspace + user
Workspaces ..> ItemRelationsEvidenceSnapshots : workspace + snapshot
Workspaces ..> AccessPolicyEvidences : workspace + snapshot
Workspaces ..> OperationalIncidents : workspace + snapshot

SyncRootRuns ..> SyncPayloadManifests
SyncPayloadManifests ..> SyncPayloadChunks
SyncJobs ..> SyncTasks
SyncJobs ..> SyncCommands

legend bottom
  Every table has a UNIQUEIDENTIFIER primary key.
  Atlas relationships use stable workspace, snapshot, Fabric item and principal identities.
  Dashed arrows are logical references, not generated SQL foreign keys.
endlegend
@enduml
