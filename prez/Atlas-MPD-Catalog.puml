@startuml
hide empty methods
hide circle
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 18
skinparam shadowing false
skinparam roundCorner 0
skinparam linetype ortho
skinparam nodesep 38
skinparam ranksep 45
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #117865
skinparam classFontColor #0C695A
skinparam classFontSize 21
skinparam classFontStyle bold
skinparam classAttributeFontColor #242424
skinparam classAttributeFontSize 18
skinparam ArrowColor #616161
skinparam ArrowFontColor #242424
skinparam noteBackgroundColor #EFF6FC
skinparam noteBorderColor #0078D4
skinparam noteFontColor #242424
skinparam classBorderColor #0078D4
skinparam classFontColor #0078D4
skinparam classFontSize 22
skinparam classAttributeFontSize 19
skinparam nodesep 60
skinparam ranksep 55
class "dbo.Workspaces" as Workspace <<table>> {
  id [PK] : UNIQUEIDENTIFIER  NOT NULL
  fabricId : NVARCHAR(100)  NOT NULL
  snapshotId : UNIQUEIDENTIFIER  NULL
  writerEmail : NVARCHAR(160)  NULL
  deploymentId : NVARCHAR(200)  NULL
  itemCount : INT  NULL
  edgeCount : INT  NULL
  syncedAt : DATETIME2  NULL
}
class "dbo.FabricItems" as FabricItem <<table>> {
  id [PK] : UNIQUEIDENTIFIER  NOT NULL
  workspace_id : UNIQUEIDENTIFIER  NOT NULL
  snapshotId : UNIQUEIDENTIFIER  NULL
  writerEmail : NVARCHAR(160)  NULL
  fabricId : NVARCHAR(100)  NOT NULL
  displayName : NVARCHAR(200)  NOT NULL
  itemType : NVARCHAR(60)  NOT NULL
  health [CK] : NVARCHAR(7)  NOT NULL
  lastRefresh : DATETIME2  NULL
}
class "dbo.ConfigEntries" as ConfigEntry <<table>> {
  id [PK] : UNIQUEIDENTIFIER  NOT NULL
  workspace_id : UNIQUEIDENTIFIER  NOT NULL
  snapshotId : UNIQUEIDENTIFIER  NULL
  writerEmail : NVARCHAR(160)  NULL
  itemFabricId : NVARCHAR(100)  NOT NULL
  section : NVARCHAR(80)  NOT NULL
  label : NVARCHAR(160)  NOT NULL
  value : NVARCHAR(2000)  NULL
}
class "dbo.LineageEdges" as LineageEdge <<table>> {
  id [PK] : UNIQUEIDENTIFIER  NOT NULL
  workspace_id : UNIQUEIDENTIFIER  NOT NULL
  snapshotId : UNIQUEIDENTIFIER  NULL
  sourceFabricId : NVARCHAR(100)  NOT NULL
  targetFabricId : NVARCHAR(100)  NOT NULL
  relation : NVARCHAR(60)  NOT NULL
  broken : BIT  NOT NULL = 0
}
Workspace -[hidden]right- FabricItem
Workspace -[hidden]down- ConfigEntry
FabricItem -[hidden]down- LineageEdge
ConfigEntry -[hidden]right- LineageEdge
@enduml