@startuml
hide empty methods
hide circle
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #117865
skinparam classFontColor #0C695A
skinparam ArrowColor #616161

class Workspace <<manifest>> {
  + id : UUID
  + fabricId : UUID
  + snapshotId : UUID
  + writerSubject : string
}

class FabricItem <<snapshot>> {
  + workspace_id : UUID
  + snapshotId : UUID
  + fabricId : UUID
  + itemType : string
}

class LineageEdge <<snapshot>> {
  + sourceFabricId : UUID
  + targetFabricId : UUID
  + relation : string
}

class Principal <<snapshot>> {
  + principalId : string
  + kind : string
}

class AccessGrant <<snapshot>> {
  + principalRef : string
  + itemFabricId : UUID
  + accessLevel : string
}

class JobRun <<snapshot>> {
  + itemFabricId : UUID
  + status : string
}

class ConfigEntry <<snapshot>> {
  + itemFabricId : UUID
  + section : string
  + label : string
}

class WorkspaceScope <<shared>> {
  + selectedWorkspaceIds : set
}

class ItemRelationsEvidenceSnapshot <<evidence>> {
  + workspaceId : UUID
  + snapshotId : UUID
  + chunkCount : int
}

class AccessPolicyEvidence <<evidence>> {
  + workspaceId : UUID
  + snapshotId : UUID
}

class OperationalIncident <<evidence>> {
  + workspaceId : UUID
  + itemFabricId : UUID
  + runId : string
}

class SavedView <<personal>> {
  + workspace_id : UUID
  + user_id : string
}

class AccessReview <<personal>> {
  + workspace_id : UUID
  + user_id : string
}

class FindingAck <<personal>> {
  + workspace_id : UUID
  + user_id : string
}

Workspace "1" --> "0..*" FabricItem
Workspace "1" --> "0..*" LineageEdge
Workspace "1" --> "0..*" Principal
Workspace "1" --> "0..*" AccessGrant
Workspace "1" --> "0..*" JobRun
Workspace "1" --> "0..*" ConfigEntry
Workspace "1" --> "0..1" ItemRelationsEvidenceSnapshot
Workspace "1" --> "0..1" AccessPolicyEvidence
Workspace "1" --> "0..*" OperationalIncident

Principal "0..1" --> "0..*" AccessGrant : principalRef
FabricItem "0..1" --> "0..*" AccessGrant : itemFabricId
FabricItem "0..1" --> "0..*" JobRun : itemFabricId
FabricItem "0..1" --> "0..*" ConfigEntry : itemFabricId

WorkspaceScope ..> Workspace : selected IDs
SavedView ..> Workspace
AccessReview ..> Workspace
FindingAck ..> Workspace
@enduml
