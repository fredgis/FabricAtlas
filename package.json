{
  "name": "fabric-atlas",
  "description": "Microsoft Fabric workspace governance, catalog and lineage explorer.",
  "author": "fredgis",
  "license": "MIT",
  "private": true,
  "version": "2.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix rayfin/functions",
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "typecheck": "tsc -b --force",
    "build": "npm run typecheck && vite build",
    "build:fabric": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild:mcp": "rayfin env --framework vite",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "mcp:atlas": "node dist-mcp/atlas-mcp.mjs",
    "test:fabric": "node scripts/open-fabric-portal.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-node": "5.6.0",
    "@microsoft/fabric-visuals": "^4.1.0",
    "@microsoft/fabric-visuals-core": "^4.1.0",
    "@microsoft/rayfin-auth": "1.36.2",
    "@microsoft/rayfin-auth-provider-fabric": "1.36.2",
    "@microsoft/rayfin-client": "1.36.2",
    "@microsoft/rayfin-core": "1.36.2",
    "@microsoft/rayfin-data": "1.36.2",
    "@microsoft/rayfin-lib": "1.36.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "1.36.2",
    "@microsoft/rayfin-mcp": "1.36.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
